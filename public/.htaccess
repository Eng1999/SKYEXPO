# ═══════════════════════════════════════════════
#  SKY EXPO — Hostinger .htaccess
#  Next.js Static Export + SEO Preservation
# ═══════════════════════════════════════════════

Options -Indexes
Options +FollowSymLinks

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ── Force HTTPS ────────────────────────────────
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # ── Force www → non-www (أو العكس حسب رغبتك) ──
  # RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  # RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # ── SEO: 301 Redirects من الموقع القديم ────────
  # إذا كان الموقع القديم WordPress يحتوي على مقالات
  # أضف هنا 301 redirect لكل URL قديم مهم:
  # RewriteRule ^blog/old-post-slug/?$ /work [R=301,L]
  # RewriteRule ^ar/about/?$ /our-story [R=301,L]
  # RewriteRule ^services/?$ /capabilities [R=301,L]

  # ── Next.js Static SPA Routing ────────────────
  # أولاً: إذا كان الملف أو المجلد موجوداً فعلاً، قدّمه مباشرة
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # ثانياً: جرّب /pathname/index.html
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # ثالثاً: جرّب /pathname.html
  RewriteCond %{REQUEST_FILENAME}.html -f
  RewriteRule ^(.*)$ $1.html [L]

  # رابعاً: Fallback → index.html (للصفحات الديناميكية)
  RewriteRule ^ /index.html [L]
</IfModule>

# ── Caching Headers ────────────────────────────
<IfModule mod_expires.c>
  ExpiresActive On

  # HTML — قصير (يتغير بالنشر)
  ExpiresByType text/html                 "access plus 1 hour"

  # Assets — طويل
  ExpiresByType image/webp                "access plus 1 year"
  ExpiresByType image/avif                "access plus 1 year"
  ExpiresByType image/jpeg                "access plus 6 months"
  ExpiresByType image/png                 "access plus 6 months"
  ExpiresByType image/svg+xml             "access plus 1 year"
  ExpiresByType text/css                  "access plus 1 year"
  ExpiresByType application/javascript    "access plus 1 year"
  ExpiresByType application/pdf           "access plus 1 month"
  ExpiresByType video/mp4                 "access plus 6 months"
  ExpiresByType font/woff2                "access plus 1 year"
</IfModule>

# ── Compression ────────────────────────────────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml font/woff2
</IfModule>

# ── Security Headers ───────────────────────────
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
